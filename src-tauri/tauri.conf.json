{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Switcher",
  "version": "0.1.0",
  "identifier": "com.ultr42.linux-desktop.wallpaper-switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wallpapers",
        "minWidth": 640,
        "minHeight": 480,
        "alwaysOnTop": true,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Wallpaper switcher for awww",
    "homepage": "https://github.com/ultraflame4/linux.wallpaper-awww",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png"
    ]
  }
}
